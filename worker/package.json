{
  "name": "cloudgold-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-sqlite test/run.mjs",
    "coverage": "npx --yes c8@10.1.3 --include='src/**' --reporter=text-summary --check-coverage --lines 80 --functions 80 --statements 80 node --experimental-sqlite test/run.mjs && npm run coverage:money",
    "coverage:money": "npx --yes c8@10.1.3 check-coverage --per-file --include=src/sms.js --include=src/nowpayments.js --include=src/chainwatch.js --include=src/pasarguard.js --include=src/marzban.js --branches 80 --lines 0 --functions 0 --statements 0",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
