{
  // Cloud Gold store Worker. The deploy workflow fills in the D1 database id.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudgold",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // Workers Logs for every request + Traces for a sample (traces need their own switch)
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // every minute: on-chain check of crypto payments; 20:30 UTC (midnight in Iran): daily report + backup;
  // every 2 minutes: one page (25 messages) of an admin broadcast, in its own invocation and subrequest budget
  "triggers": { "crons": ["* * * * *", "30 20 * * *", "*/2 * * * *"] },
  // Workers Rate Limiting (counted per Cloudflare location): RL_IP caps sign-ups, logins and free trials per IP,
  // RL_LOGIN caps login attempts per email. namespace_id is any number unique within the account.
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_LOGIN", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudgold",
      "database_id": "PLACEHOLDER_FILLED_BY_DEPLOY",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set with `wrangler secret put` or in the dashboard, NOT here):
  //   SECRET_KEY, JWT_SECRET (optional), PASARGUARD_URL, PASARGUARD_USERNAME, PASARGUARD_PASSWORD, PASARGUARD_API_KEY,
  //   PASARGUARD_USERNAME_PREFIX, PUBLIC_BASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID,
  //   TELEGRAM_WEBHOOK_SECRET, NOWPAYMENTS_API_KEY, NOWPAYMENTS_IPN_SECRET, NOWPAYMENTS_PAY_CURRENCY
}
