<?xml version="1.0" encoding="utf-8"?>
<!-- Switch wait: a 54×32dp track with a 24dp thumb. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/note_ice" />
            <stroke android:width="1dp" android:color="@color/note_ice" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="15dp" android:right="15dp" android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/note_on_button" />
        </shape>
    </item>
</layer-list>
