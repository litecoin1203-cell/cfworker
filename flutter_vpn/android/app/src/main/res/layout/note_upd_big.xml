<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded update card (Updates.kt): title and time left, the line,
     the three-part track the app paints (Download, Check, Install, with
     the Pleat mark riding it), and text buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/upd_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/note_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/upd_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/note_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/upd_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/note_muted"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/upd_track"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/upd_from"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="70"
            android:maxLines="1"
            android:textColor="@color/note_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="15"
            android:gravity="center"
            android:maxLines="1"
            android:text="Check"
            android:textColor="@color/note_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/upd_to"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="15"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/note_link"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/upd_go"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="24dp"
            android:textAllCaps="true"
            android:textColor="@color/note_link"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/upd_later"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="24dp"
            android:text="Later"
            android:textAllCaps="true"
            android:textColor="@color/note_link"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
