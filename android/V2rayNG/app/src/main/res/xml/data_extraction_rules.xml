<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rule as backup_rules.xml, for cloud backup and for device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="mmkv/cloudgold_session" />
        <exclude domain="file" path="mmkv/cloudgold_session.crc" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="mmkv/cloudgold_session" />
        <exclude domain="file" path="mmkv/cloudgold_session.crc" />
    </device-transfer>
</data-extraction-rules>
